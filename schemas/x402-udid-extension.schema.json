{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/impactsai/udid/schemas/x402-udid-extension.schema.json",
  "title": "x402 UDID extension v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "required", "offerId", "bindingDigest", "credentialTypes", "presentationFormats", "holderBinding"],
  "properties": {
    "version": {"const": "1"},
    "required": {"type": "boolean"},
    "offerId": {"type": "string", "minLength": 1},
    "bindingDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "credentialTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "presentationFormats": {"type": "array", "minItems": 1, "items": {"enum": ["jwt_vc_json", "jwt_vp_json", "vc+ld+json"]}, "uniqueItems": true},
    "holderBinding": {"enum": ["none", "did-authentication"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "boolean"}, "capability": {"type": "string"}}
    }
  }
}
