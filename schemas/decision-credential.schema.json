{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/impactsai/udid/schemas/decision-credential.schema.json",
  "title": "UDID Decision Credential Subject v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "decision"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "outcome", "policy", "evaluatedAt", "binding"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "decision_to_pay"},
        "outcome": {"enum": ["approved", "declined"]},
        "evaluatedAt": {"type": "string", "format": "date-time"},
        "reasonCodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authorityReference": {"type": "string", "minLength": 1},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64}|u[1-9A-HJ-NP-Za-km-z]+)$"}
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offerId", "bindingDigest", "resource", "network", "asset", "payTo", "amount"],
          "properties": {
            "offerId": {"type": "string", "minLength": 1},
            "bindingDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "resource": {"type": "string", "format": "uri"},
            "network": {"type": "string", "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"},
            "asset": {"type": "string", "minLength": 1},
            "payTo": {"type": "string", "minLength": 1},
            "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          }
        }
      }
    }
  }
}
