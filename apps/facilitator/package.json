{
  "name": "@udid/x402-facilitator-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:workers": "node --import tsx --test test/worker.integration.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:workers",
    "openapi": "node --import tsx scripts/openapi.ts",
    "demo:setup": "node --import tsx scripts/setup-demo.ts",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "@ucans/core": "0.12.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "jose": "6.2.12",
    "json-canonicalize": "3.0.0",
    "multiformats": "14.0.5",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/node": "26.5.0",
    "miniflare": "5.20260907.0-alpha",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  }
}
