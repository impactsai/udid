  "components": {
    "securitySchemes": {
      "resourceServerKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OfferInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "resource": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "mimeType": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          "paymentRequirements": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "exact",
                  "stripe-manual-capture"
                ]
              },
              "network": {
                "type": "string",
                "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,77})$"
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "payTo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxTimeoutSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 300
              },
              "extra": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "scheme",
              "network",
              "amount",
              "asset",
              "payTo",
              "maxTimeoutSeconds"
            ],
            "additionalProperties": false
          },
          "requireUcan": {
            "type": "boolean"
          },
          "requireUdid": {
            "type": "boolean"
          }
        },
        "required": [
          "resource",
          "paymentRequirements"
        ],
        "additionalProperties": false
      },
      "PaymentRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "x402Version": {
            "type": "number",
            "const": 2
          },
          "offerId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "paymentRequirements": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "exact",
                  "stripe-manual-capture"
                ]
              },
              "network": {
                "type": "string",
                "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,77})$"
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "payTo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxTimeoutSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 300
              },
              "extra": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "scheme",
              "network",
              "amount",
              "asset",
              "payTo",
              "maxTimeoutSeconds"
            ],
            "additionalProperties": false
          },
          "paymentPayload": {
            "type": "object",
            "properties": {
              "x402Version": {
                "type": "number",
                "const": 2
              },
              "accepted": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "stripe-manual-capture"
                    ]
                  },
                  "network": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$"
                  },
                  "asset": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "payTo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 300
                  },
                  "extra": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "scheme",
                  "network",
                  "amount",
                  "asset",
                  "payTo",
                  "maxTimeoutSeconds"
                ],
                "additionalProperties": false
              },
              "resource": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "mimeType": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              },
              "payload": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "extensions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "x402Version",
              "accepted",
              "payload"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "x402Version",
          "offerId",
          "paymentRequirements",
          "paymentPayload"
        ],
        "additionalProperties": false
      }
    }
  }
}
