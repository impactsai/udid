          "503": {
            "description": "Stable error code; no credential or provider error details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settlements/{id}": {
      "get": {
        "summary": "Read a settlement record owned by the authenticated tenant",
        "security": [
          {
            "resourceServerKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "settlementId, offerId, state and optional result; no raw signed transaction"
          },
          "401": {
            "description": "Stable error code; no credential or provider error details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Stable error code; no credential or provider error details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
